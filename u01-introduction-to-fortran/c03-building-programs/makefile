

# Compiler and flags
F90 = gfortran
FFLAGS = -J $(BUILD_DIR) -I $(BUILD_DIR)

# Directories
SRC_DIR   = src
BUILD_DIR = build
DIST_DIR  = dist

.PHONY: all clean dirs

all: dirs $(PROGRAM_BINS)

clean:
	rm -rf $(BUILD_DIR) $(DIST_DIR)

dirs:
	mkdir -p $(BUILD_DIR) $(DIST_DIR)

# Modules
MODULES := user_functions mymath
MODULE_SRCS := $(addprefix $(SRC_DIR)/, $(addsuffix .f90, $(MODULES)))
MODULE_OBJS := $(addprefix $(BUILD_DIR)/, $(addsuffix .o, $(MODULES)))
MODULE_MODS := $(addprefix $(BUILD_DIR)/, $(addsuffix .mod, $(MODULES)))

# Programs
PROGRAM_SRCS := $(filter-out $(MODULE_SRCS), $(wildcard $(SRC_DIR)/*.f90))
PROGRAMS := $(basename $(notdir $(PROGRAM_SRCS)))
PROGRAM_OBJS := $(patsubst $(SRC_DIR)/%.f90, $(BUILD_DIR)/%.o, $(PROGRAM_SRCS))
PROGRAM_BINS := $(addprefix $(DIST_DIR)/, $(PROGRAMS))

$(MODULE_OBJS): $(BUILD_DIR)/%.o : $(SRC_DIR)/%.f90
	$(F90) $(FFLAGS) -c $< -o $@

# Declare that .mod files are generated by compiling module objects
$(MODULE_MODS): %.mod: %.o
	@true

# Compile program objects with explicit .mod dependencies
# List program -> module .mod dependencies here:
$(BUILD_DIR)/e02-tabulate.o: $(BUILD_DIR)/user_functions.mod
$(BUILD_DIR)/e04-static-link.o: $(BUILD_DIR)/mymath.mod

# Compile program objects, order-only prerequisite on module objects
$(PROGRAM_OBJS): $(BUILD_DIR)/%.o : $(SRC_DIR)/%.f90 | $(MODULE_OBJS)
	$(F90) $(FFLAGS) -c $< -o $@

# Link program binaries, include all module objects
$(DIST_DIR)/%: $(BUILD_DIR)/%.o | $(MODULE_OBJS)
	$(F90) $(FFLAGS) -o $@ $^ $(MODULE_OBJS)

